{
  "name": "bakatracker-platform",
  "version": "0.1.0",
  "private": true,
  "description": "BakaTracker v2 platform — one Tool Registry, many interfaces (REST + MCP). Cloudflare Workers native.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "db:init": "wrangler d1 execute bakas_db --local --file=./schema.sql",
    "db:migrate": "wrangler d1 migrations apply bakas_db --local"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.1",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.105.0"
  }
}
