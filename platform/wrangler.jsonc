{
  // ============================================================
  // BakaTracker platform — LOCAL DEVELOPMENT configuration.
  //
  // This file is the repository default. It is deliberately free of
  // any personal Cloudflare resource IDs so the repo can be forked
  // and deployed by anyone.
  //
  //   * D1/KV ids below are PLACEHOLDERS — valid format, but they
  //     exist only so `wrangler dev` can run against local state.
  //   * Run `npm run setup` (repo root) to generate
  //     `platform/wrangler.prod.jsonc` with YOUR account's real
  //     D1/KV ids + origin, and to provision secrets.
  //   * Deploy with `npm run deploy` (uses wrangler.prod.jsonc).
  //
  // Do NOT edit the ids here for production deploys — the setup
  // script owns the production config.
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakatracker-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "BAKA_DB",
      "database_name": "bakas_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // R2: local dev + the vitest pool simulate the bucket (no real resource
  // needed). Production configs only include this binding when the instance
  // was set up with `--with-r2`:
  //   "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "<name>-files" }]
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "bakatracker-files-local"
    }
  ],
  // AI binding intentionally omitted from local dev (it's a remote resource and
  // forces an API token). `npm run setup -- --with-ai` adds it to the
  // production config:
  //   "ai": { "binding": "AI" }
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "SYNC_LOCK_TTL_SECONDS": 60
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  }
}