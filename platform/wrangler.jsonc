{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakatracker-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5eb48db3bd274f6087eafcada74955b6"
    }
  ],
  "d1_databases": [
    {
      "binding": "BAKA_DB",
      "database_name": "bakas_db",
      "database_id": "bb8219f5-8c61-4403-bc2b-a7edbab889b5",
      "migrations_dir": "./migrations"
    }
  ],
  // AI binding intentionally omitted from local dev (it's a remote resource and
  // forces an API token). Add it back for `wrangler dev --remote` / deploy:
  //   "ai": { "binding": "AI" }
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "SYNC_LOCK_TTL_SECONDS": 60
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  }
}