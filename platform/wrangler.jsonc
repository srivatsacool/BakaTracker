{
  // ============================================================
  // BakaTracker platform — LOCAL DEVELOPMENT configuration.
  //
  // This file is the repository default. It is deliberately free of
  // any personal Cloudflare resource IDs so the repo can be forked
  // and deployed by anyone.
  //
  //   * D1/KV ids below are PLACEHOLDERS — valid format, but they
  //     exist only so `wrangler dev` can run against local state.
  //   * Run `npm run setup` (repo root) to generate
  //     `platform/wrangler.prod.jsonc` with YOUR account's real
  //     D1/KV ids + origin, and to provision secrets.
  //   * Deploy with `npm run deploy` (uses wrangler.prod.jsonc).
  //
  // Do NOT edit the ids here for production deploys — the setup
  // script owns the production config.
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakatracker-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "PUSH_SUBSCRIPTIONS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "BAKA_DB",
      "database_name": "bakas_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // R2: local dev + the vitest pool simulate the bucket (no real resource
  // needed). Production configs only include this binding when the instance
  // was set up with `--with-r2`:
  //   "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "<name>-files" }]
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "bakatracker-files-local"
    }
  ],
  // AI binding intentionally omitted from local dev (it's a remote resource and
  // forces an API token). `npm run setup -- --with-ai` adds it to the
  // production config:
  //   "ai": { "binding": "AI" }
  //
  // Without a provider, AI endpoints answer deterministically:
  //   503 { ok:false, error:"ai_unavailable" }.
  // The proactive notification engine skips message generation entirely.
  //
  // Cron Trigger for the proactive BakaSur `scheduled` handler. In local dev
  // nothing fires automatically; use `wrangler dev --test-scheduled` to
  // trigger it manually. Production scheduling is owned by setup.mjs
  // (regenerates wrangler.prod.jsonc with the same schedule).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    // Vite dev server origin (http://localhost:5173) is the browser origin in
    // local dev — the API lives at :8787, so the two MUST cross-talk. The
    // allowlist is exact-origin; no wildcards.
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174",
    "SYNC_LOCK_TTL_SECONDS": 60,
    "AI_MODEL": "@cf/meta/llama-3.2-1b-instruct",
    // --- Web Push (proactive notifications) ----------------------------------
    // VAPID contact + PUBLIC key are safe to keep in source. The PRIVATE key
    // is a SECRET — set it with `wrangler secret put VAPID_PRIVATE_KEY`
    // (local: add to .dev.vars) and NEVER commit it. Generate a keypair with:
    //   npx web-push generate-vapid-keys
    "VAPID_SUBJECT": "mailto:notifications@bakatracker.app",
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY"
    // "VAPID_PRIVATE_KEY": "<set via wrangler secret put; do not inline>"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  }
}