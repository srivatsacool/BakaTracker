# ============================================================
# BakaTracker — frontend build configuration (Vite)
# Copy this file to `.env` for local development.
# These are BUILD-TIME vars: production values are set in the
# Cloudflare Pages project's environment variables, NOT in this file.
# ============================================================

# Cloudflare Worker origin that serves REST + OAuth + MCP.
#   - local dev:    http://localhost:8787   (default when unset in dev)
#   - production:   https://<worker-name>.<account-subdomain>.workers.dev
#                   or your custom API domain
# Run `npm run setup`, which prints your exact production origin.
VITE_API_BASE_URL=http://localhost:8787

# Google OAuth Client ID (the SPA uses it only to show whether login is
# configured — the Worker owns the actual OAuth flow).
# Create one at https://console.cloud.google.com/apis/credentials
# and register the redirect URI printed at the end of `npm run setup`.
VITE_GOOGLE_CLIENT_ID=