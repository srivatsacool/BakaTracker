# BakaTracker MCP Backend Environment Variables Example

# The public Web App URL of your deployed Google Apps Script database driver
# Example: https://script.google.com/macros/s/AKfycby.../exec
GOOGLE_APPS_SCRIPT_URL=your_google_apps_script_url_here

# (Optional) The API key configured in your Google Sheets database to prevent unauthorized access
GOOGLE_APPS_SCRIPT_API_KEY=your_optional_sheets_api_key_here

# The custom secret token required for client authentication (Bearer Token)
# Clients must supply "Authorization: Bearer <AUTH_TOKEN>"
AUTH_TOKEN=your_mcp_access_bearer_token_here

# (Optional) Local port configuration. Default is 8080 (Cloud Run standard)
PORT=8080

# (Optional) Log level setting (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# (Optional) Timeout for requests to Google Apps Script (in seconds)
TIMEOUT=10.0
